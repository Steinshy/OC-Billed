  "author": "techer jean sebastien <techerjeansebastien.pro@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development sequelize-cli db:migrate && node server.js",
    "seed": "NODE_ENV=development sequelize-cli db:migrate && node seed.js",
    "test": "NODE_ENV=test sequelize-cli db:migrate && jest -i --watchAll=false",
    "test:watch": "NODE_ENV=test sequelize-cli db:migrate && jest -i --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "sequelize": "^6.37.7",
    "short-uuid": "^6.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "sequelize-fixtures": "^1.2.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./setupTests.js"
    ]
  }
