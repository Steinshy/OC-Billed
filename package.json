{
  "name": "oc-billed",
  "version": "1.0.0",
  "private": true,
  "description": "Billed — expense report SaaS (OpenClassrooms project). pnpm workspace: Backend (Express API) + Frontend (vanilla JS SPA).",
  "author": "techer jean sebastien <techerjeansebastien.pro@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm --filter billed-backend dev\" \"pnpm --filter billed-frontend dev\"",
    "dev:backend": "pnpm --filter billed-backend dev",
    "dev:frontend": "pnpm --filter billed-frontend dev",
    "seed": "pnpm --filter billed-backend seed",
    "test": "pnpm --recursive --no-bail run test",
    "lint": "pnpm --recursive --no-bail run lint",
    "lint:fix": "pnpm --recursive --no-bail run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update:check": "pnpm --recursive outdated",
    "update:interactive": "pnpm --recursive update --interactive --latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "17.7.0",
    "jest": "^30.2.0",
    "jest-html-reporter": "^4.3.0",
    "prettier": "^3.9.5"
  }
}
