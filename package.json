{
  "name": "oc-billed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Billed — expense report app (OpenClassrooms project). Vanilla JS SPA at the root (src/) + Express API workspace (Backend/).",
  "author": "techer jean sebastien <techerjeansebastien.pro@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "pnpm --filter billed-backend dev",
    "dev:frontend": "live-server --no-browser",
    "seed": "pnpm --filter billed-backend seed",
    "test": "jest --coverage --noStackTrace --silent && pnpm --filter billed-backend test",
    "lint": "eslint . && stylelint \"src/css/**/*.css\" && prettier --check .",
    "fix": "eslint . --fix && stylelint \"src/css/**/*.css\" --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jquery": "^3.7.1",
    "live-server": "^1.2.2",
    "lucide": "1.59.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "24",
        "onFail": "download"
      }
    ]
  },
  "packageManager": "pnpm@11.15.1"
}
